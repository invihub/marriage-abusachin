# Copy to .env and fill in. In GitHub, add these as repository secrets.
SUPABASE_URL=https://<project-id>.supabase.co
# This site's schema ("folder") in the shared Supabase project
SUPABASE_SCHEMA=abu_sachin
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Admin only (local scripts). Not needed for the website build.
SUPABASE_SECRET_KEY=sb_secret_...
